{
  "_comment": "Bulwark 服务配置。放在 bulwark_service.exe 同目录。以管理员/服务身份运行才能启用 ETW 实时观测与内核驱动。",
  "Bulwark": {
    "EventSource": "Driver",
    "KernelDriverEnabled": true,
    "TrustSignedActors": true,
    "PromptTimeoutSeconds": 30,
    "ExportEcsAlerts": false,
    "OnlineCertRevocationCheck": false,

    "ProtectedPaths": [
      "\\Start Menu\\Programs\\Startup\\",
      "\\System32\\drivers\\etc\\hosts",
      "\\Tasks\\"
    ],
    "FileHardBlocks": [],
    "ProtectedRegistryKeys": [
      "\\CurrentVersion\\Run",
      "\\CurrentVersion\\RunOnce",
      "\\CurrentVersion\\Policies\\Explorer\\Run",
      "\\Image File Execution Options\\",
      "\\Winlogon",
      "\\Services\\"
    ],
    "RegistryHardBlocks": [],
    "MemoryProtectionTargets": [ "lsass.exe" ],
    "BlockedRemoteEndpoints": [],

    "Etw": {
      "Enabled": true,
      "DnsClient": true,
      "KernelNetwork": true,
      "KernelRegistry": true,
      "KernelFile": true,
      "NetworkUntrustedOnly": true,
      "SuspiciousOnly": true
    },

    "VirusTotal": {
      "Enabled": true,
      "_comment": "Key 来源优先级: 环境变量 BULWARK_VT_APIKEY > 此处 ApiKey > 构建期内置。多 Key 用英文逗号分隔; 每个可选按 KEY 或 KEY:每日上限 或 KEY:每日上限:每分钟上限 标注单 Key 额度(不标注即用下方默认, VT 免费档 500/天、4/分)。每个 Key 独立计账、额度真正叠加(如 5 个免费 Key = 2500/天), 某 Key 被限流(429)或鉴权失败(401)会自动冷却跳过。免费 Key 建议留空此处、改用环境变量, 切勿写入版本库。混用/Premium 示例见 README。RequestsPerMinute/RequestsPerDay 现为每 Key 默认值。",
      "ApiKey": "",
      "RequestsPerMinute": 4,
      "RequestsPerDay": 500,
      "PriorityDailyReserve": 50
    },
    "MalwareBazaar": { "Enabled": true },
    "Otx": { "Enabled": true },
    "ThreatBook": { "Enabled": true },
    "MetaDefender": { "Enabled": true },
    "HybridAnalysis": { "Enabled": true },
    "ThreatFoxFeed": { "Enabled": true },

    "Ai": {
      "BaseUrl": "https://token-plan-sgp.xiaomimimo.com/v1",
      "ApiKey": "",
      "Model": "mimo-v2.5-pro"
    }
  }
}
